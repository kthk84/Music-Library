# Repo-wide ignores. v1/.gitignore and v2/.gitignore cover version-specific
# state files (cover_cache/, .soundeo_browser_profile/, shazam_status_cache.json, etc).

# macOS
.DS_Store
Thumbs.db

# IDE / editor (workspace-level, IDE detects via parent walk)
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/

# Test / automation caches
.playwright-mcp/

# Build artifacts
build/
dist/
*.egg-info/
SoundBridge.app/

# Atomic-write temp files (_save_json_atomic leaves these only if the process is
# killed mid-write; never commit them)
*.tmp.*
*.tmp2.*
